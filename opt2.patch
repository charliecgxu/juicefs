+	}
+	for _, s := range *slices {
+		if IsSparseSliceID(s.Id) {
+			if st := m.ReadOverlay(ctx, inode, indx, overlays); st != 0 {
+				return true, st
+			}
+			return true, 0
+		}
+	}
+	return false, 0
+}
