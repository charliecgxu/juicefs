+func createSparseFile(t *testing.T, v *VFS, name string) (Context, meta.Ino, uint64) {
+	t.Helper()
+	ctx := NewLogContext(meta.NewContext(1, 1, []uint32{1}))
+	entry, fh, st := v.Create(ctx, 1, name, 0644, 0, syscall.O_RDWR)
+	require.Zero(t, st)
+	return ctx, entry.Inode, fh
