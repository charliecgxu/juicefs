new file mode 100644
index 0000000000000000000000000000000000000000..7d90bf9b6e589f8b2166ae95f704509aabf542f8
--- /dev/null
+++ b/cmd/flush_staging.go
@@ -0,0 +1,167 @@
+/*
+ * JuiceFS, Copyright 2026 Juicedata, Inc.
+ *
